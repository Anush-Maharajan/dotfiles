{
  "fontFamily": "Inter Variable",
  "monoFontFamily": "JetBrains Mono",
  "cursorSettings": {
    "theme": "Vimix-white-cursors",
    "size": 24
  },
  "cornerRadius": 12,
  "popupTransparency": 0.35,
  "dockTransparency": 0.35,
  "border": {
    "enable": true,
    "width": 2,
    "activeColor": "#7aa2f7",
    "inactive": {
      "enable": false,
      "width": 0
    }
  },
  "barConfigs": [
    {
      "id": "default",
      "name": "Main Bar",
      "enabled": true,
      "position": 0,
      "screenPreferences": [
        {
          "name": "eDP-1"
        }
      ],
      "leftWidgets": ["workspaceSwitcher"],
      "centerWidgets": [
        {
          "id": "clock",
          "enabled": true,
          "format": "%I:%M %p  •  %a %b %e"
        },
        {
          "id": "music",
          "enabled": true,
          "showVisualizer": true,
          "showTitle": true,
          "showArtist": true
        }
      ],
      "rightWidgets": [
        {
          "id": "systemTray",
          "enabled": true
        },
        {
          "id": "controlCenterButton",
          "enabled": true
        },
        {
          "id": "battery",
          "enabled": true
        },
        "notificationButton"
      ],
      "spacing": 4,
      "barInsetPadding": 4,
      "transparency": 0.35
    }
  ]
}

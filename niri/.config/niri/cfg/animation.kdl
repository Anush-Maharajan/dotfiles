animations {
    // 1. Workspace Switching
    workspace-switch {
        spring damping-ratio=1.0 stiffness=650 epsilon=0.0001
    }
    // 2. Camera & Column Motion
    horizontal-view-movement {
        spring damping-ratio=1.0 stiffness=700 epsilon=0.0001
    }
    window-movement {
        spring damping-ratio=1.0 stiffness=650 epsilon=0.0001
    }
    // 3. Window Resizing — cursor-locked but slightly less twitchy
    window-resize {
        spring damping-ratio=1.0 stiffness=750 epsilon=0.0001
    }
    // 4. Window Open/Close
    window-open {
        duration-ms 120
        curve "ease-out-expo"
    }
    window-close {
        duration-ms 100
        curve "ease-out-quad"
    }
    // 5. Shell & System UI Overlays
    overview-open-close {
        spring damping-ratio=0.95 stiffness=750 epsilon=0.0001
    }
    config-notification-open-close {
        spring damping-ratio=0.85 stiffness=900 epsilon=0.001
    }
    screenshot-ui-open {
        duration-ms 120
        curve "ease-out-expo"
    }
}

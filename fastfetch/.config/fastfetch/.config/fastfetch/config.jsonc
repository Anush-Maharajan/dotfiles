{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "type": "command-raw",
    "source": "pokemon-colorscripts --no-title --random",
    "padding": {
      "right": 5,
    },
    "printRemaining": true,
  },

  "display": {
    "separator": "  ",
    "key": {
      "width": 14,
    },
  },

  "modules": [
    {
      "type": "title",
    },

    {
      "type": "custom",
      "format": "─────────────",
    },

    {
      "type": "os",
      "key": "  OS",
    },

    {
      "type": "kernel",
      "key": "󰌽  Kernel",
    },

    {
      "type": "uptime",
      "key": "󰥔  Uptime",
    },

    "break",

    {
      "type": "cpu",
      "key": "󰻠  CPU",
      "format": "{name} ({cores-physical}C/{cores-logical}T)",
    },

    {
      "type": "gpu",
      "key": "󰢮  GPU",
    },

    {
      "type": "memory",
      "key": "  Memory",
    },

    {
      "type": "disk",
      "key": "󰋊  Disk",
      "folders": ["/"],
    },

    "break",

    {
      "type": "shell",
      "key": "  Shell",
    },

    {
      "type": "terminal",
      "key": "  Terminal",
    },
  ],
}
